datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String      @id @default(uuid())
  name           String
  email          String      @unique
  passwordHash   String
  role           String      @default("USER") // USER or ADMIN
  status         String      @default("ACTIVE") // ACTIVE or SUSPENDED
  avatarUrl      String?
  githubUsername String?
  linkedinUrl    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  portfolios     Portfolio[]
  uploads        Upload[]
  auditLogs      AuditLog[]
  sessions       Session[]
}

model Portfolio {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug         String      @unique
  title        String
  headline     String?
  bio          String?
  location     String?
  contactEmail String?
  avatarUrl    String?
  resumeUrl    String?
  githubUrl    String?
  linkedinUrl  String?
  showLinkedin Boolean     @default(true)
  websiteUrl   String?
  templateId   String      @default("developer") // minimal, developer, creative, editorial, academic, executive
  layoutType   String      @default("grid") // grid, flexbox
  themeConfig  String      @default("{\"primaryColor\":\"#ffffff\",\"darkTheme\":true,\"fontFamily\":\"inter\",\"showGithubStats\":true}")
  sectionOrder String      @default("[\"bio\",\"projects\",\"skills\",\"experience\",\"education\"]")
  isPublished  Boolean     @default(false)
  publishedAt  DateTime?
  views        Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  projects       Project[]
  skills         Skill[]
  education      Education[]
  experience     Experience[]
  socialLinks    SocialLink[]
  reports        PortfolioReport[]
  versions       PortfolioVersion[]
  accessRequests AccessRequest[]
}

model PortfolioVersion {
  id          String    @id @default(uuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  version     Int       @default(1)
  name        String?
  snapshot    String    // Full serialized JSON snapshot of portfolio data
  createdAt   DateTime  @default(now())
}

model AccessRequest {
  id            String    @id @default(uuid())
  portfolioId   String
  portfolio     Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  requesterName String
  organization  String
  email         String
  requestedRole String    @default("Recruiter / Evaluator")
  reason        String
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
}

model Project {
  id             String    @id @default(uuid())
  portfolioId    String
  portfolio      Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  title          String
  description    String
  technologies   String    // Comma-separated or JSON string
  repositoryUrl  String?
  demoUrl        String?
  imageUrl       String?
  featured       Boolean   @default(false)
  displayOrder   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Skill {
  id           String    @id @default(uuid())
  portfolioId  String
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  name         String
  category     String    @default("Technical") // Languages, Frameworks, Tools, etc.
  proficiency  Int?      // 1-100 or null
  displayOrder Int       @default(0)
}

model Education {
  id          String    @id @default(uuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  institution String
  degree      String
  field       String?
  startDate   String?
  endDate     String?
  description String?
}

model Experience {
  id          String    @id @default(uuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  company     String
  role        String
  startDate   String?
  endDate     String?
  isCurrent   Boolean   @default(false)
  description String?
}

model SocialLink {
  id          String    @id @default(uuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  platform    String    // github, linkedin, twitter, website, etc.
  url         String
}

model Upload {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  createdAt    DateTime @default(now())
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model PortfolioReport {
  id            String    @id @default(uuid())
  portfolioId   String
  portfolio     Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  reporterEmail String
  reason        String
  status        String    @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt     DateTime  @default(now())
}
