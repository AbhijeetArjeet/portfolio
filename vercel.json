{
  "installCommand": "npm install --prefix client",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://portfolio-paxa.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://portfolio-paxa.onrender.com/uploads/$1"
    },
    {
      "source": "/((?!api/|uploads/).*)",
      "destination": "/index.html"
    }
  ]
}
