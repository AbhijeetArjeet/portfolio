# Server Environment Variables
PORT=5000
NODE_ENV=production
# In development: file:./dev.db
# In production on Render: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/portfolio_db

# Security & Sessions
JWT_SECRET=replace_with_a_secure_random_64_char_secret_string
SESSION_SECRET=replace_with_a_secure_session_secret_string

# Frontend CORS URL (e.g., https://your-portfolio-app.vercel.app)
CLIENT_URL=http://localhost:5173

# Render Deployment & Keep-Alive Monitoring
# Set to your Render Web Service public URL (e.g. https://portfolio-api-xyz.onrender.com)
RENDER_EXTERNAL_URL=https://your-service.onrender.com

# External Keep-Alive Monitor interval (14 minutes resets Render 15-min idle sleep)
MONITORING_INTERVAL_MINUTES=14

# GitHub Integration (Optional OAuth / Personal Token for higher rate limits)
GITHUB_API_TOKEN=
